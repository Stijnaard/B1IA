    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Adult -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Adult">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAge"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">110</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Child"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Child -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Child">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAge"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
    </owl:Class>
    


