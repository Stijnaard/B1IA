        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Adult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Adult"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isPartOf"/>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#sharesBorderWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#sharesBorderWith">
