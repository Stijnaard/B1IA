    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPopulation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPopulation">
        <rdfs:domain>
