    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAge -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasFamousFood -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasFamousFood">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPopulation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPopulation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPosition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPosition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasProperty -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasProperty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Landmarks"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPublicHolidays -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPublicHolidays">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasRevenue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasRevenue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasSkillLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasSkillLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isPublicOwned -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isPublicOwned">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#numOfEmployees -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#numOfEmployees">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#producesProduct -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#producesProduct">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Adult -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Adult">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAge"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:minInclusive>
                                    </rdf:Description>
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">110</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Child"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Child -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Child">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAge"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Elder"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Concert -->

    <owl:Class rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Concert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Event"/>
