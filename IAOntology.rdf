<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology/"
     xml:base="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:IAOntology="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology">
        <rdfs:comment>Ontology for first deliverable Intelligent Agents</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#activeIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#activeIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOfficeIn"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isCityIn"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#affectsPerson -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#affectsPerson">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCondition"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#HealthConditions"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#allergicTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#allergicTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#associatedWithHoliday -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#associatedWithHoliday">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Tradition"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Holiday"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#availableOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#availableOn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#streams"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Title"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#belongsToTeam -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#belongsToTeam">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPlayer"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#canEat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#canEat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Food"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#celebratedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#celebratedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#recognizesHoliday"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Holiday"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#celebrates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#celebrates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Holiday"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#competesAgainst -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#competesAgainst">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#competesWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#competesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#containsIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#containsIngredient">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#ingredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Food"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#containsPlace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#containsPlace">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#locatedIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#countryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#countryOfOrigin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#determinesWinnerBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#determinesWinnerBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Sport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#WinCondition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#doesSport -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#doesSport">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Sport"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#eats -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#eats">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Food"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#employedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#employedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#employs"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#employs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#employs">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAwayTeam -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasAwayTeam">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Match"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCapital -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCapital">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isCapitalOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCitizen -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCitizen">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isCitizenOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCondition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#HealthConditions"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasFamousFood -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasFamousFood">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Food"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Title"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Genre"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasGovernmentForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasGovernmentForm">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#GovernmentForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasHeadOfState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasHeadOfState">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasCitizen"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#HeadOfState"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasHomeTeam -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasHomeTeam">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Match"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasLandmark -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasLandmark">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#isLandmarkIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Landmarks"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOccupation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOccupation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Job"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOfficeIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOfficeIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Cities"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOfficialLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOfficialLanguage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Languages"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOutcome -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasOutcome">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Outcome"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasParticipant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasParticipant">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#League"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPartnershipWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPartnershipWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Company"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPlayer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPlayer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#Player"/>
    </owl:ObjectProperty>
    


