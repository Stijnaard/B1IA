    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#inIndustry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#inIndustry">
