        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPosition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/stijnroos/ontologies/2026/8/IAOntology#hasPosition">
